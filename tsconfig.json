{
  // Design Pattern Academy — strict, and no ambient @types: what the checks
  // grade is what you wrote. Safe to delete; recreated when you open an exercise.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts"]
}
